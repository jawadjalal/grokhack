# Copy to .env.local. Get the team's exact Grok model and key from Jawad.
# A bare Grok model ID selects direct xAI (e.g. grok-4.7).
MODEL=
XAI_API_KEY=

# Optional: an AI Gateway provider/model ID in MODEL uses these instead.
AI_GATEWAY_API_KEY=

# Optional, explicitly supplied sponsor sizes keyed by lowercase domain.
# These are planning assumptions, not facts inferred from match scores.
# Example format: {"example.com":"large"}
PITCH_SPONSOR_SIZES={}

# Supabase: Project Settings → API. service_role writes the seed; never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notion: share only the Backer pipeline database with an internal connection.
NOTION_TOKEN=
# Use the database's data source ID, not its page ID.
NOTION_DATA_SOURCE_ID=

# Resend: FROM must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
