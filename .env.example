# Supabase: Project Settings → API. service_role writes the seed; never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Notion: create an integration at notion.so/my-integrations, share a page with it
NOTION_TOKEN=
# Either an existing database, or a page to create "Backer pipeline" under
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Resend (send-only key is fine). FROM must be on a verified domain, else only your own address receives.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
